{
	"name": "jobaculator",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.0.0",
	"engines": {
		"node": ">=24 <25"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm lint:migrations && pnpm test",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src/web",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:boundaries": "depcruise src",
		"lint:migrations": "tsx scripts/check-migrations.ts",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:record-llm": "LLM_LIVE=1 LLM_RECORD=1 vitest run --project db src/packages/ai/tests/adapters.db.test.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/migrate.ts",
		"cli": "tsx src/cli.ts",
		"dev:server": "tsx watch src/server.ts",
		"dev:worker": "tsx watch src/worker.ts",
		"dev:web": "vite",
		"build": "tsx scripts/build.ts",
		"build:web": "vite build",
		"ops:provision": "tsx ops/provision.ts",
		"ops:deploy": "tsx ops/deploy.ts",
		"ops:run": "tsx ops/run.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.11.0",
		"@hono/node-server": "^2.1.9",
		"@trpc/server": "^11.29.5",
		"better-auth": "^1.7.24",
		"drizzle-orm": "^0.45.4",
		"entities": "^8.1.0",
		"hono": "^4.13.19",
		"mammoth": "^1.13.0",
		"node-html-markdown": "2.0.0",
		"openai": "^7.61.0",
		"pdfjs-dist": "^6.5.438",
		"pg": "^8.23.1",
		"pg-boss": "^12.38.2",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@swc/core": "^1.16.22",
		"@tailwindcss/vite": "^4.3.5",
		"@tanstack/react-query": "^5.108.1",
		"@tanstack/react-router": "^1.170.46",
		"@trpc/client": "^11.29.5",
		"@trpc/tanstack-react-query": "^11.29.5",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dependency-cruiser": "^18.8.0",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"lucide-react": "^1.76.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.5",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	}
}
