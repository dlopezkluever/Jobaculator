{
	"name": "jobaculator",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.0.0",
	"engines": {
		"node": ">=24 <25"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.0.0",
			"onFail": "download"
		}
	},
	"scripts": {
		"check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm lint:migrations && pnpm test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:boundaries": "depcruise src",
		"lint:migrations": "tsx scripts/check-migrations.ts",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/migrate.ts",
		"dev:server": "tsx watch src/server.ts",
		"dev:worker": "tsx watch src/worker.ts",
		"build": "tsx scripts/build.ts"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.9",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.19",
		"pg": "^8.23.1",
		"pg-boss": "^12.38.2",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@swc/core": "^1.16.22",
		"@types/node": "^24.19.2",
		"@types/pg": "^8.23.1",
		"dependency-cruiser": "^18.8.0",
		"drizzle-kit": "^0.31.11",
		"esbuild": "^0.28.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1"
	}
}
